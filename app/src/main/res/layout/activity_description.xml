<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="#7B92A2"
    android:orientation="vertical"
    tools:context=".CardView.DescriptionActivity">

    <TextView
        android:id="@+id/tv_nombred"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="250dp"
        android:drawableLeft="@drawable/outline_person_black_24dp"
        android:hint="Nombre"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textAlignment="center"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_cedulad"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="550dp"
        android:hint="ID"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textAlignment="center"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />



    <TextView
        android:id="@+id/tv_estadod"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:drawableLeft="@drawable/outline_rule_black_24dp"
        android:text="Estado"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_nombred" />


    <TextView
        android:id="@+id/tv_FechaIngreso2"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:drawableLeft="@drawable/outline_calendar_month_black_24dp"
        android:text="  Fecha de Ingreso"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textColor="#004400"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_estadod" />
    <TextView
        android:id="@+id/tv_fechaVd"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:drawableLeft="@drawable/outline_content_paste_off_black_24dp"
        android:text="   F. vencimiento"
        android:textSize="20sp"
        android:textAlignment="center"
        android:textColor="#801515"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_FechaIngreso2" />

    <EditText
        android:id="@+id/et_mensualidades"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Mensualidades"
        android:inputType="numberSigned"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_fechaVd" />

    <Button
        android:id="@+id/btn_actualizar"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/design_default_color_secondary"
        android:drawableLeft="@drawable/outline_receipt_long_black_24dp"
        android:text="REGISTRAR"
        android:textSize="12dp"
        android:textColor="#363341"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_mensualidades" />

    <Button
        android:id="@+id/btn_borrar"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/design_default_color_secondary"
        android:drawableLeft="@drawable/outline_delete_black_24dp"
        android:text="ELIMINAR"
        android:textSize="12dp"
        android:textColor="#363341"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_actualizar" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="70dp"
        android:text="PERFIL DE USUARIO"
        android:textStyle="bold"
        android:textSize="20dp"
        android:textColor="#363341"
        app:layout_constraintBottom_toTopOf="@+id/tv_nombred"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>